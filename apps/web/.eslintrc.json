{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": ["@next/next", "react-hooks"],
  "extends": ["plugin:@next/next/core-web-vitals-legacy"],
  "rules": {
    "react-hooks/rules-of-hooks": "error"
  }
}

